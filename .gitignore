# Environments
.venv/
__pycache__/
*.pyc
*.egg-info/
build/
dist/

# Raw input data, tracked separately / not committed via normal git (large binary
# files -- data/ alone has individual .h5ad files over GitHub's 100MB per-file limit)
Dataset/
data/

# Derived artifacts under outputs/. The heavy binaries (~739 MB of .npz/.pt) stay
# untracked -- they are regenerable from src/ and too large for git. But the small
# human-readable results (per-section metrics, ablation tables, run summaries) ARE
# tracked: they are the evidence every report in results/ cites, and losing them is
# not hypothetical -- outputs/mp_mnca/ and outputs/prior_models/ both went missing
# while four documents still cited their numbers, which nobody could then verify.
# The whole tracked set is only ~3 MB.
#
# `outputs/**` plus the `!outputs/**/` directory re-include is required: with a plain
# `outputs/*` git never descends into subdirectories, so negations inside them are
# silently ignored.
outputs/**
!outputs/**/
!outputs/README.md
!outputs/**/*.csv
!outputs/**/*.json
!outputs/**/*.md
# Provenance for runs whose numbers are quoted in the READMEs: the exploratory
# sweep scripts that produced them, and the stdout of the long runs (~108 KB).
!outputs/**/*.py
!outputs/**/*.log
# Legacy per-spot k-NN dumps (~18 MB): row-per-spot intermediates, not results.
outputs/analysis/*knn_predictions_full.csv
outputs/analysis/*changed_spots.csv
checkpoints/

# Reference papers: STAIG.pdf (6 MB) is tracked for history, but the 44 MB SPARC
# paper is a public arXiv preprint (2507.06265) -- permanent clone bloat for
# something anyone can re-download.
SPARC_concept_aligned_SAE_cross_modal.pdf

# OS
.DS_Store
__MACOSX/

# Editors
.vscode/
.idea/
*.log
